  {
   "item_id": "el-e7bfa1",
   "text": "Doctor, when will I be able to speak?"
  },
  {
   "item_id": "el-643c17",
   "text": "Maybe we should get some fresh air."
  },
  {
   "item_id": "el-84abf2",
   "text": "I have headache."
  },
  {
   "item_id": "el-04c9d1",
   "text": "Can you drop me home?"
  },
  {
   "item_id": "el-523944",
   "text": "Then go clean up soon before we go out."
  },
  {
   "item_id": "el-307b9c",
   "text": "somethings not right"
  },
  {
   "item_id": "el-7db3cd",
   "text": "i dont feel so good and you making me more upset"
  },
  {
   "item_id": "el-2c6803",
   "text": "i think i have cold feet"
  },
  {
   "item_id": "el-f8f45a",
   "text": "I hate this show."
  },
  {
   "item_id": "el-267b09",
   "text": "Can we go to the market later?"
  },
  {
   "item_id": "el-1d1f6d",
   "text": "Can you help me get up?"
  },
  {
   "item_id": "el-67e21a",
   "text": "Yes, it was really sad."
  },
  {
   "item_id": "el-00850c",
   "text": "Could you please bring me a glass of water?"
  },
  {
   "item_id": "el-a713b1",
   "text": "I am doing very well, thank you for asking"
  },
  {
   "item_id": "el-f35c36",
   "text": "Why makes you think that?"
  },
  {
   "item_id": "el-f09349",
   "text": "i wish i could join you in trip!"
  },
  {
   "item_id": "el-1b24f0",
   "text": "Let me think about it."
  },
  {
   "item_id": "el-f4b6d8",
   "text": "You shouldn't do that."
  },
  {
   "item_id": "el-6772ce",
   "text": "Don't get angry."
  },
  {
   "item_id": "el-19e921",
   "text": "Pass me that book there."
  },
  {
   "item_id": "el-3a85be",
   "text": "Place does not matter."
  },
  {
   "item_id": "el-d7a37b",
   "text": "You are very nice."
  },
  {
   "item_id": "el-725110",
   "text": "Don't stay out too late."
  },
  {
   "item_id": "el-7eeef0",
   "text": "I like your hair."
  },
  {
   "item_id": "el-d3af80",
   "text": "buy me new comfortable chair, this one isnt good"
  },
  {
   "item_id": "el-c41e22",
   "text": "Please come again"
  },
  {
   "item_id": "el-2878ab",
   "text": "I am not responsible for whatever's happened to me."
  },
  {
   "item_id": "el-546087",
   "text": "Can we meet up today?"
  },
  {
   "item_id": "el-19a3c0",
   "text": "I never thought about that."
  },
  {
   "item_id": "el-d64345",
   "text": "Would you pass me the book?"
  },
  {
   "item_id": "el-29ed24",
   "text": "thats nice, lets do it again"
  },
  {
   "item_id": "el-d62e63",
   "text": "How is school?"
  },
  {
   "item_id": "el-97a7b6",
   "text": "The answer is final."
  },
  {
   "item_id": "el-1ca191",
   "text": "What do you do?"
  },
  {
   "item_id": "el-ccee83",
   "text": "I would really like to hug you."
  },
  {
   "item_id": "el-a9447b",
   "text": "go outside, i want some time alone"
  },
  {
   "item_id": "el-6644da",
   "text": "Could I please take a look at that book?"
  }
 ]
