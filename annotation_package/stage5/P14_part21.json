   "text": "It is time to get ready to go."
  },
  {
   "item_id": "p21-420861b0",
   "text": "I don't think so"
  },
  {
   "item_id": "p21-7e2b558b",
   "text": "inform me again"
  },
  {
   "item_id": "p21-9fcefeaf",
   "text": "Did they get a divorce?"
  },
  {
   "item_id": "p21-acc4111c",
   "text": "What classes are offered for summer session at the technical college?"
  },
  {
   "item_id": "p21-63e6730a",
   "text": "Can you play chess?"
  },
  {
   "item_id": "p21-dcf4c852",
   "text": "I am not feeling well."
  },
  {
   "item_id": "p21-2b1a5769",
   "text": "Can you drop me home?"
  },
  {
   "item_id": "p21-28f14c6c",
   "text": "medium black coffee please"
  },
  {
   "item_id": "p21-5acd50f6",
   "text": "Please put out the garbage."
  },
  {
   "item_id": "p21-16233c26",
   "text": "No, not today, maybe tomorrow."
  },
  {
   "item_id": "p21-8b11bf70",
   "text": "Meet me in park."
  },
  {
   "item_id": "p21-e61cc112",
   "text": "Have a look at my childs, please."
  },
  {
   "item_id": "p21-24bda463",
   "text": "Place does not matter."
  },
  {
   "item_id": "p21-d7d91d85",
   "text": "It was so beautiful!"
  },
  {
   "item_id": "p21-447503b5",
   "text": "Please pray for me."
  },
  {
   "item_id": "p21-4f9ebb3d",
   "text": "turn on tv please."
  },
  {
   "item_id": "p21-ca39fe3e",
   "text": "Give me some junk food, I am tired of all this hospital stuff."
  },
  {
   "item_id": "p21-e8d034af",
   "text": "Don't laugh at me."
  },
  {
   "item_id": "p21-ffbd5d9c",
   "text": "Please turn up the heat, it's cold in here!"
  }
